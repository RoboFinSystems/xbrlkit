@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rs:    <https://robosystems.ai/vocab/> .
@prefix hs:    <https://robosystems.ai/vocab/shapes/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xbrli: <http://www.xbrl.org/2003/instance#> .
@prefix xlink: <http://www.w3.org/1999/xlink#> .
@prefix link:  <http://www.xbrl.org/2003/linkbase#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# #lineage: the ledger behind the facts. Optional, and written by the producer
# that holds the books. A fact is derived from contributions (one per entity
# and account); a contribution's members are ledger lines; a line belongs to an
# entry, an entry to a transaction, and each was generated by an event.
#
# A contribution may list no members: that is the form a holon carries when the
# lines themselves are withheld, and the count still says how many there were.

hs:ContributionShape a sh:NodeShape ;
  sh:targetClass rs:Contribution ;
  sh:property [
    sh:path rs:substantiates ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:message "A contribution substantiates exactly one fact, by IRI." ] ;
  sh:property [
    sh:path rs:lineCount ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "A contribution states how many ledger lines it stands for, once." ] ;
  sh:property [
    sh:path prov:hadMember ; sh:nodeKind sh:IRI ;
    sh:message "A contribution's members are ledger lines, by IRI." ] ;
  sh:property [
    sh:path rs:account ; sh:maxCount 1 ; sh:class rs:Account ;
    sh:message "A contribution's account is an rs:Account described in this graph." ] ;
  sh:property [
    sh:path rs:entity ; sh:maxCount 1 ; sh:class rs:LedgerEntity ;
    sh:message "A contribution's entity is an rs:LedgerEntity described in this graph." ] ;
  sh:property [ sh:path rs:amount ; sh:maxCount 1 ] ;
  sh:property [ sh:path rs:windowStart ; sh:maxCount 1 ] ;
  sh:property [ sh:path rs:windowEnd ; sh:maxCount 1 ] .

hs:LineItemShape a sh:NodeShape ;
  sh:targetClass rs:LineItem ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] ;
  sh:property [
    sh:path rs:entry ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rs:Entry ;
    sh:message "A ledger line belongs to exactly one rs:Entry, described in this graph." ] ;
  sh:property [
    sh:path rs:account ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rs:Account ;
    sh:message "A ledger line posts to exactly one rs:Account, described in this graph." ] ;
  sh:property [ sh:path rs:debit ; sh:maxCount 1 ] ;
  sh:property [ sh:path rs:credit ; sh:maxCount 1 ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:class rs:Event ;
    sh:message "A ledger line was generated by at most one rs:Event, described in this graph." ] .

hs:EntryShape a sh:NodeShape ;
  sh:targetClass rs:Entry ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] ;
  sh:property [
    sh:path rs:transaction ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rs:Transaction ;
    sh:message "An entry belongs to exactly one rs:Transaction, described in this graph." ] ;
  sh:property [
    sh:path rs:postingDate ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "An entry states its posting date, once." ] ;
  sh:property [ sh:path rs:entryStatus ; sh:maxCount 1 ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:class rs:Event ;
    sh:message "An entry was generated by at most one rs:Event, described in this graph." ] .

hs:TransactionShape a sh:NodeShape ;
  sh:targetClass rs:Transaction ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] ;
  sh:property [
    sh:path rs:transactionDate ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "A transaction states its date, once." ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:class rs:Event ;
    sh:message "A transaction was generated by at most one rs:Event, described in this graph." ] .

hs:EventShape a sh:NodeShape ;
  sh:targetClass rs:Event ;
  sh:class prov:Activity ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] ;
  sh:property [
    sh:path rs:eventType ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "An event states its type, once." ] ;
  sh:property [
    sh:path rs:occurredAt ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "An event states when it occurred, once." ] ;
  sh:property [
    sh:path prov:wasAssociatedWith ; sh:class rs:Agent ;
    sh:message "An event's agent is an rs:Agent described in this graph." ] .

hs:AccountShape a sh:NodeShape ;
  sh:targetClass rs:Account ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] ;
  sh:property [
    sh:path skos:prefLabel ; sh:minCount 1 ;
    sh:message "An account has a name." ] .

hs:AgentShape a sh:NodeShape ;
  sh:targetClass rs:Agent ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] .

hs:LedgerEntityShape a sh:NodeShape ;
  sh:targetClass rs:LedgerEntity ;
  sh:property [
    sh:path rs:internalId ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:message "The node carries its identifier as rs:internalId, once." ] .

# What does not belong here. A reader takes an rs:Entity or an rs:Element to
# be the report's own, so the ledger's entities and accounts have their own
# classes and the report's classes stay out of this graph.
hs:NoFactInLineage a sh:NodeShape ;
  sh:targetClass rs:Fact ;
  sh:property [ sh:path rdf:type ; sh:maxCount 0 ;
    sh:message "An rs:Fact belongs in #scene, not #lineage." ] .

hs:NoElementInLineage a sh:NodeShape ;
  sh:targetClass rs:Element ;
  sh:property [ sh:path rdf:type ; sh:maxCount 0 ;
    sh:message "A chart account in #lineage is an rs:Account, not an rs:Element." ] .

hs:NoEntityInLineage a sh:NodeShape ;
  sh:targetClass rs:Entity ;
  sh:property [ sh:path rdf:type ; sh:maxCount 0 ;
    sh:message "A member entity in #lineage is an rs:LedgerEntity, not an rs:Entity." ] .

hs:NoReportInLineage a sh:NodeShape ;
  sh:targetClass rs:Report ;
  sh:property [ sh:path rdf:type ; sh:maxCount 0 ;
    sh:message "The rs:Report belongs in #scene, not #lineage." ] .

hs:NoAssociationInLineage a sh:NodeShape ;
  sh:targetClass rs:Association ;
  sh:property [ sh:path rdf:type ; sh:maxCount 0 ;
    sh:message "An rs:Association belongs in #projection or #boundary, not #lineage." ] .
